<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}"/>
        <Setter Property="SelectedIndicatorColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
        <Setter Property="StrokeShape" Value="Rectangle"/>
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Chartreuse}" />
        <Setter Property="FontFamily" Value="SansSemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinimumHeightRequest" Value="52"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkEntryBackground}}" />
        <Setter Property="FontFamily" Value="SansSemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinimumHeightRequest" Value="48"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="SansRegular"/>
        <Setter Property="FontSize" Value="15" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkEntryBackground}}" />
        <Setter Property="FontFamily" Value="SansRegular"/>
        <Setter Property="FontSize" Value="16" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}" />
        <Setter Property="MinimumHeightRequest" Value="48"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Frame">
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="SansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="SeparatorColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
        <Setter Property="RefreshControlColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkEntryBackground}}" />
        <Setter Property="FontFamily" Value="SansSemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinimumHeightRequest" Value="48"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="HeightRequest" Value="4"/>
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource DarkMainColor}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="FontFamily" Value="SansRegular"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkSoft}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource InkSoft}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="SansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SearchHandler">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource InkSoft}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="SansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="15" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Brush" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
        <Setter Property="Offset" Value="10,10" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}" />
        <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                            <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource DarkMainColor}}" />
        <Setter Property="ThumbColor" Value="{StaticResource White}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="On">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource DarkMainColor}}" />
                            <Setter Property="ThumbColor" Value="{StaticResource Chartreuse}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Off">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkEntryBackground}}" />
        <Setter Property="FontFamily" Value="SansSemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinimumHeightRequest" Value="48"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Ground}, Dark={StaticResource DarkGround}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Ground}, Dark={StaticResource DarkGround}}" />
        <Setter Property="ForegroundColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
        <Setter Property="UnselectedColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}" />
        <Setter Property="NavBarHasShadow" Value="False" />
        <Setter Property="TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}" />
        <Setter Property="TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}" />
        <Setter Property="TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Ground}, Dark={StaticResource DarkGround}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Nav}, Dark={StaticResource DarkNav}}" />
        <Setter Property="BarTextColor" Value="{StaticResource Chartreuse}" />
        <Setter Property="UnselectedTabColor" Value="{StaticResource OnNav}" />
        <Setter Property="SelectedTabColor" Value="{StaticResource Chartreuse}" />
    </Style>

    <!-- Design system building blocks -->

    <!-- "The note": one dark-green card per screen that carries the key number -->
    <Style TargetType="Border" x:Key="NoteCard">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource DarkNoteGreen}}"/>
    </Style>

    <Style TargetType="Label" x:Key="NoteHeroAmount">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontFamily" Value="SansBold"/>
        <Setter Property="CharacterSpacing" Value="-0.72"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="LineBreakMode" Value="NoWrap"/>
    </Style>

    <Style TargetType="Label" x:Key="NoteAmount">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="CharacterSpacing" Value="-0.24"/>
        <Setter Property="FontFamily" Value="SansBold"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
    </Style>

    <Style TargetType="BoxView" x:Key="NoteDivider">
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource NoteTrack}, Dark={StaticResource DarkNoteTrack}}"/>
    </Style>

    <Style TargetType="Label" x:Key="SectionTitle">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="CharacterSpacing" Value="-0.2"/>
        <Setter Property="FontFamily" Value="SansBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
    </Style>

    <Style TargetType="Label" x:Key="RowTitle">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontFamily" Value="SansSemiBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
    </Style>

    <Style TargetType="Label" x:Key="RowCaption">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="SansRegular"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}"/>
    </Style>

    <Style TargetType="Ellipse" x:Key="SpendingDot">
        <Setter Property="WidthRequest" Value="8"/>
        <Setter Property="HeightRequest" Value="8"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>

    <!-- Application-specific styles -->

    <Style TargetType="Border" x:Key="ExpenseCard">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
    </Style>

    <Style TargetType="Label" x:Key="ExpenseCardTitle" BasedOn="{StaticResource SectionTitle}"/>

    <Style TargetType="Label" x:Key="ExpenseCardSubtitle" BasedOn="{StaticResource RowTitle}"/>

    <Style TargetType="Label" x:Key="ExpenseCardSubtitleSecondary">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontFamily" Value="SansRegular"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}"/>
    </Style>

    <Style TargetType="ProgressBar" x:Key="ExpenseCardProgressBar">
        <Setter Property="HeightRequest" Value="4"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource DarkLine}}"/>
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource DarkMainColor}}" />
    </Style>

    <Style TargetType="Label" x:Key="ExpenseCardProgressValue" BasedOn="{StaticResource RowCaption}"/>

    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}"/>
        <Setter Property="BorderWidth" Value="1.5"/>
    </Style>

    <Style TargetType="Label" x:Key="SettingsButtonText">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontFamily" Value="SansSemiBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
    </Style>

    <Style TargetType="Label" x:Key="CategoryCardName">
        <Setter Property="FontFamily" Value="SansBold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
        <Setter Property="FontSize" Value="17"/>
    </Style>

    <!-- Theme and language settings page -->
    <Style TargetType="Border" x:Key="ThemeSettingsButton">
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
    </Style>

    <Style TargetType="Border" x:Key="ThemeSettingsButtonActive">
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource DarkNoteGreen}}"/>
    </Style>

    <!-- Profiles Settings Page -->
    <Style TargetType="Border" x:Key="ProfileCard">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
    </Style>

    <Style TargetType="Border" x:Key="CurrentProfileCard" BasedOn="{StaticResource NoteCard}"/>

    <Style TargetType="Label" x:Key="CurrentProfileCardName">
        <Setter Property="FontFamily" Value="SansBold"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style TargetType="Border" x:Key="CurrencyBadge">
        <Setter Property="WidthRequest" Value="48"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Ground}, Dark={StaticResource DarkLine}}"/>
    </Style>

    <Style TargetType="Border" x:Key="CurrentCurrencyBadge" BasedOn="{StaticResource CurrencyBadge}">
        <Setter Property="BackgroundColor" Value="{StaticResource Chartreuse}"/>
    </Style>

    <Style TargetType="Label" x:Key="CurrencyBadgeText">
        <Setter Property="FontFamily" Value="SansBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource Chartreuse}}"/>
    </Style>

    <!-- Auth Page -->
    <Style TargetType="Border" x:Key="MissedAuthCodeDigit">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="MaximumHeightRequest" Value="56" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Height" Value="56" />
    </Style>

    <Style TargetType="Border" x:Key="ActiveAuthCodeDigit">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource NoteGreen}, Dark={StaticResource DarkNoteGreen}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Height" Value="56" />
