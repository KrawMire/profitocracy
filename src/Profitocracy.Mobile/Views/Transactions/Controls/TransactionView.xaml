<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Profitocracy.Mobile.Models.Transactions"
             xmlns:controls="clr-namespace:Profitocracy.Mobile.Views.Transactions.Controls"
             x:Class="Profitocracy.Mobile.Views.Transactions.Controls.TransactionView"
             x:DataType="models:TransactionModel">
    <!-- A single transaction on its own card -->
    <Border Style="{StaticResource Card}">
        <controls:TransactionRowView Transaction="{Binding}"/>
    </Border>
</ContentView>
