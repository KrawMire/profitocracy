<?xml version="1.0" encoding="utf-8"?>

<abstractions:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                              xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
                              xmlns:resx="clr-namespace:Profitocracy.Mobile.Resources.Strings"
                              xmlns:abstractions="clr-namespace:Profitocracy.Mobile.Abstractions"
                              xmlns:viewmodel="clr-namespace:Profitocracy.Mobile.ViewModels.Transactions"
                              xmlns:categories="clr-namespace:Profitocracy.Mobile.Models.Categories"
                              xmlns:controls="clr-namespace:Profitocracy.Mobile.Views.Shared.Controls"
                              x:Class="Profitocracy.Mobile.Views.Transactions.Pages.EditTransactionPage"
                              x:DataType="viewmodel:EditTransactionPageViewModel"
                              Loaded="EditTransactionPage_OnLoaded"
                              Shell.PresentationMode="ModalAnimated"
                              ios:Page.ModalPresentationStyle="PageSheet"
                              SafeAreaEdges="All"
                              HideSoftInputOnTapped="True">
    <abstractions:BaseContentPage.Resources>
        <!-- Spending type card: dot, name and the word of the split -->
        <Style TargetType="Border" x:Key="TypeCard">
            <Setter Property="MinimumHeightRequest" Value="56"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
        </Style>
        <!-- Field tile: note, date, time and repeat -->
        <Style TargetType="Border" x:Key="FieldTile">
            <Setter Property="HeightRequest" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"/>
        </Style>
    </abstractions:BaseContentPage.Resources>

    <Grid RowDefinitions="auto,*,auto"
          Padding="0,8,0,0">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="88,*,88"
              Padding="8,0">
            <Label Grid.Column="0"
                   Style="{StaticResource LinkLabel}"
                   HorizontalOptions="Start"
                   Padding="8,0"
                   Text="{x:Static resx:AppResources.Common_Cancel}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CloseButton_OnClicked"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1"
                   Style="{StaticResource TextBodyStrong}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   Text="{Binding Title}"/>
        </Grid>

        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,8,16,0"
                                 Spacing="12">

                <!-- Expense / Income -->
                <Border Style="{StaticResource Card}"
                        Padding="4">
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="4">
                        <controls:ChipView Grid.Column="0"
                                           Text="{x:Static resx:AppResources.AddTransaction_Expense}"
                                           IsSelected="{Binding IsExpense}"
                                           Tapped="ExpenseButton_OnClicked"/>
                        <controls:ChipView Grid.Column="1"
                                           Text="{x:Static resx:AppResources.AddTransaction_Income}"
                                           IsSelected="{Binding IsIncome}"
                                           Tapped="IncomeButton_OnClicked"/>
                    </Grid>
                </Border>

                <!-- The amount, typed with the system number pad -->
                <Border Style="{StaticResource Card}"
                        Padding="16,12,16,14"
                        StrokeThickness="2"
                        Stroke="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AmountCard_OnTapped"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="auto,*"
                              ColumnSpacing="8">
                            <Border Grid.Column="0"
                                    Padding="10,0"
                                    HeightRequest="44"
                                    VerticalOptions="Center"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Ground}, Dark={StaticResource DarkGround}}"
                                    SemanticProperties.Description="{x:Static resx:AppResources.NewTransaction_Currency}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="CurrencyButton_OnTapped"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Style="{StaticResource TextBodyStrong}"
                                           VerticalTextAlignment="Center"
                                           Text="{Binding EditedCurrencyCode}"/>
                                    <controls:IconView Data="{x:Static controls:Icons.ChevronDown}"
                                                       Size="16"
                                                       VerticalOptions="Center"
                                                       Color="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
                                </HorizontalStackLayout>
                            </Border>
                            <controls:BorderlessEntry x:Name="AmountEntry"
                                                      Grid.Column="1"
                                                      BackgroundColor="Transparent"
                                                      VerticalOptions="Center"
                                                      HorizontalTextAlignment="End"
                                                      Keyboard="Numeric"
                                                      FontFamily="SansBold"
                                                      FontSize="36"
                                                      CharacterSpacing="-0.72"
                                                      Placeholder="0.00"
                                                      MinimumHeightRequest="44"
                                                      SemanticProperties.Description="{x:Static resx:AppResources.NewTransaction_Amount}"
                                                      Text="{Binding EditedAmount, Mode=TwoWay}"/>
                        </Grid>
                        <Label Style="{StaticResource TextLabelSoft}"
                               HorizontalTextAlignment="End"
                               IsVisible="{Binding IsMultiCurrency}"
                               Text="{Binding ConvertedText}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ConvertedAmount_OnTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- Expense: 50 / 30 / 20 spending type -->
                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="8"
                      IsVisible="{Binding IsExpense}">
                    <Border Grid.Column="0"
                            Style="{StaticResource TypeCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MainTypeButton_OnClicked"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsMain}"
                                         Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MainColor}, Dark={StaticResource DarkMainColor}}"/>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MainTint}, Dark={StaticResource DarkMainTint}}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse Style="{StaticResource SpendingDot}"
                                         Fill="{AppThemeBinding Light={StaticResource MainColor}, Dark={StaticResource DarkMainColor}}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       Text="{x:Static resx:AppResources.AddTransaction_Main}"/>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource TextCaption}"
                                   Margin="14,0,0,0"
                                   Text="{x:Static resx:AppResources.Common_NeedsWord}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                            Style="{StaticResource TypeCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SecondaryTypeButton_OnClicked"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsSecondary}"
                                         Value="True">
                                <Setter Property="Stroke" Value="{StaticResource SecondaryColor}"/>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryTint}, Dark={StaticResource DarkSecondaryTint}}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse Style="{StaticResource SpendingDot}"
                                         Fill="{StaticResource SecondaryColor}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       Text="{x:Static resx:AppResources.AddTransaction_Secondary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSecondary}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource DarkSecondaryTextColor}}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource TextCaption}"
                                   Margin="14,0,0,0"
                                   Text="{x:Static resx:AppResources.Common_WantsWord}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2"
                            Style="{StaticResource TypeCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SavedTypeButton_OnClicked"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsSaved}"
                                         Value="True">
                                <Setter Property="Stroke" Value="{StaticResource SavedColor}"/>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SavedTint}, Dark={StaticResource DarkSavedTint}}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="2"
                                             VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse Style="{StaticResource SpendingDot}"
                                         Fill="{StaticResource SavedColor}"/>
                                <Label Style="{StaticResource TextBodyStrong}"
                                       Text="{x:Static resx:AppResources.AddTransaction_Saved}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSaved}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SavedText}, Dark={StaticResource DarkSavedText}}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource TextCaption}"
                                   Margin="14,0,0,0"
                                   Text="{x:Static resx:AppResources.Common_SavingsWord}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Expense: category -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Margin="0,0,-16,0"
                            IsVisible="{Binding IsExpense}">
                    <HorizontalStackLayout Spacing="8"
                                           Padding="0,0,16,0"
                                           BindableLayout.ItemsSource="{Binding CategoryChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="categories:CategoryChipModel">
                                <controls:ChipView Text="{Binding Name}"
                                                   IsSelected="{Binding IsSelected}"
                                                   Tapped="CategoryChip_OnTapped"/>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Income: what happens with it -->
                <Border Style="{StaticResource Card}"
                        Padding="16,14"
                        IsVisible="{Binding IsIncome}">
                    <Label Style="{StaticResource TextBodySoft}"
                           Text="{Binding IncomeHint}"/>
                </Border>

                <!-- Note -->
                <Border Style="{StaticResource FieldTile}">
                    <controls:BorderlessEntry BackgroundColor="Transparent"
                                              MinimumHeightRequest="44"
                                              VerticalOptions="Center"
                                              FontSize="15"
                                              Placeholder="{x:Static resx:AppResources.NewTransaction_Note}"
                                              Text="{Binding Description, Mode=TwoWay}"/>
                </Border>

                <!-- Date and time -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="8">
                    <Border Grid.Column="0"
                            Style="{StaticResource FieldTile}">
                        <Grid>
                            <Label Style="{StaticResource TextBodyStrong}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   InputTransparent="True"
                                   Text="{Binding DateText}"/>
                            <!-- Invisible native picker over the tile opens the system date picker -->
                            <DatePicker Opacity="0.02"
                                        TextColor="Transparent"
                                        BackgroundColor="Transparent"
                                        Date="{Binding Timestamp, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1"
                            Style="{StaticResource FieldTile}">
                        <Grid>
                            <Label Style="{StaticResource TextBodyStrong}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   InputTransparent="True"
                                   Text="{Binding TimeText}"/>
                            <!-- Invisible native picker over the tile opens the system time picker -->
                            <TimePicker Opacity="0.02"
                                        TextColor="Transparent"
                                        BackgroundColor="Transparent"
                                        Time="{Binding Time, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Repeat -->
                <Border Style="{StaticResource FieldTile}">
                    <Grid>
                        <Grid ColumnDefinitions="*,auto"
                              ColumnSpacing="4"
                              InputTransparent="True"
                              CascadeInputTransparent="True">
                            <Label Grid.Column="0"
                                   Style="{StaticResource TextBodyStrong}"
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   Text="{Binding IntervalText}"/>
                            <controls:IconView Grid.Column="1"
                                               Data="{x:Static controls:Icons.ChevronDown}"
                                               Size="16"
                                               VerticalOptions="Center"
                                               Color="{AppThemeBinding Light={StaticResource InkSoft}, Dark={StaticResource DarkInkSoft}}"/>
                        </Grid>
                        <Picker x:Name="IntervalPicker"
                                Opacity="0.02"
                                TextColor="Transparent"
                                BackgroundColor="Transparent"
                                Title="{x:Static resx:AppResources.NewTransaction_Repeat}"
                                SelectedItem="{Binding SelectedInterval}"
                                ItemDisplayBinding="{Binding Name}"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save -->
        <Button Grid.Row="2"
                Margin="16,12,16,16"
                Style="{StaticResource AccentButton}"
                Text="{Binding SaveText}"
                Clicked="EditTransactionButton_OnClicked"/>
    </Grid>
</abstractions:BaseContentPage>
