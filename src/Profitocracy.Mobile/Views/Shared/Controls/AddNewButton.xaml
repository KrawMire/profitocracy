<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Profitocracy.Mobile.Views.Shared.Controls.AddNewButton"
             WidthRequest="60"
             HeightRequest="60">
    <Button BackgroundColor="{StaticResource Chartreuse}"
            WidthRequest="60"
            HeightRequest="60"
            CornerRadius="30"
            Padding="0"
            ImageSource="{FontImage &#xf217;,
                FontFamily={OnPlatform iOS=Ionicons, Android=Ionicons.ttf#},
                Color={StaticResource Ink},
                Size=24}"
            Clicked="InternalAddNewButton_OnClicked">
        <Button.Shadow>
            <Shadow Brush="{StaticResource Ink}"
                    Offset="0,6"
                    Radius="14"
                    Opacity="0.25" />
        </Button.Shadow>
    </Button>
</ContentView>
