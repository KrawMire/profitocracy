<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Profitocracy.Mobile.Views.Shared.Controls.SkeletonRow">
    <!-- Placeholder of a card row while the period is being calculated -->
    <VerticalStackLayout Padding="16,14"
                         Spacing="8">
        <Grid ColumnDefinitions="auto,*,auto">
            <BoxView Grid.Column="0"
                     Style="{StaticResource Skeleton}"
                     WidthRequest="104"
                     HeightRequest="20"/>
            <BoxView Grid.Column="2"
                     Style="{StaticResource Skeleton}"
                     WidthRequest="72"
                     HeightRequest="20"/>
        </Grid>
        <BoxView Style="{StaticResource Skeleton}"
                 HorizontalOptions="Start"
                 WidthRequest="160"
                 HeightRequest="16"/>
        <BoxView Style="{StaticResource Skeleton}"
                 HeightRequest="4"
                 CornerRadius="2"/>
    </VerticalStackLayout>
</ContentView>
