<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Profitocracy.Mobile.Views.Shared.Controls"
             x:Class="Profitocracy.Mobile.Views.Shared.Controls.ModalHeaderView"
             x:DataType="controls:ModalHeaderView">
    <!-- Header of a sheet: close button and a centred title -->
    <Grid ColumnDefinitions="44,*,44"
          Margin="-8,0">
        <Grid Grid.Column="0"
              HeightRequest="44">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="CloseButton_OnClicked"/>
            </Grid.GestureRecognizers>
            <controls:IconView Data="{x:Static controls:Icons.Close}"
                               Size="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource DarkInk}}"/>
        </Grid>

        <Label Grid.Column="1"
               Style="{StaticResource TextBodyStrong}"
               Text="{Binding Title}"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"/>
    </Grid>
</ContentView>
