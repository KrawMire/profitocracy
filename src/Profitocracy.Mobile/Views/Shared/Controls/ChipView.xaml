<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Profitocracy.Mobile.Views.Shared.Controls"
             x:Class="Profitocracy.Mobile.Views.Shared.Controls.ChipView">
    <!-- Filter / choice chip: surface when idle, ink with white text when selected -->
    <Border x:Name="Root"
            x:DataType="controls:ChipView"
            Style="{StaticResource Chip}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="Root_OnTapped"/>
        </Border.GestureRecognizers>
        <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding IsSelected}"
                         Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Chartreuse}}"/>
            </DataTrigger>
        </Border.Triggers>
        <Label Style="{StaticResource ChipText}"
               Text="{Binding Text}">
            <Label.Triggers>
                <DataTrigger TargetType="Label"
                             Binding="{Binding IsSelected}"
                             Value="True">
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Ink}}"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Border>
</ContentView>
