<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:Profitocracy.Mobile"
       xmlns:resx="clr-namespace:Profitocracy.Mobile.Resources.Strings"
       xmlns:homepages="clr-namespace:Profitocracy.Mobile.Views.Home.Pages"
       xmlns:transactionpages="clr-namespace:Profitocracy.Mobile.Views.Transactions.Pages"
       xmlns:overviewpages="clr-namespace:Profitocracy.Mobile.Views.Overview.Pages"
       xmlns:settingspages="clr-namespace:Profitocracy.Mobile.Views.Settings.Pages"
       x:Class="Profitocracy.Mobile.AppShell"
       Loaded="AppShell_OnLoaded">
    <TabBar>
        <Tab Title="{x:Static resx:AppResources.Pages_Home}" Icon="home.png">
            <ShellContent Route="HomePage"
                          ContentTemplate="{DataTemplate homepages:HomePage}"/>
        </Tab>
        <Tab Title="{x:Static resx:AppResources.Pages_Activity}" Icon="transactions.png">
            <ShellContent Route="TransactionsPage"
                          Title="{x:Static resx:AppResources.Pages_Transactions_All}"
                          ContentTemplate="{DataTemplate transactionpages:TransactionsPage}"/>
        </Tab>
        <!-- Not a real page: selecting it opens the new transaction sheet, see AppShell.OnNavigating -->
        <Tab Route="{x:Static local:AppShell.AddTransactionRoute}"
             Title=""
             Icon="add_transaction.png">
            <ShellContent>
                <ContentPage/>
            </ShellContent>
        </Tab>
        <Tab Title="{x:Static resx:AppResources.Pages_Insights}" Icon="chart.png">
            <ShellContent Route="OverviewPage"
                          ContentTemplate="{DataTemplate overviewpages:OverviewPage}"/>
        </Tab>
        <Tab Title="{x:Static resx:AppResources.Pages_Settings}" Icon="settings.png">
            <ShellContent Route="SettingsPage"
                          ContentTemplate="{DataTemplate settingspages:SettingsPage}"/>
        </Tab>
    </TabBar>
</Shell>
